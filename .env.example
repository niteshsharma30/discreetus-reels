# Copy this file to .env and fill it in. Never share or commit .env.

# true = nothing is sent to Instagram. Set to false once a dry run looks right.
DRY_RUN=true
TIMEZONE=Asia/Kolkata
BRAND_NAME=discreetUS
WAITLIST_URL=https://your-site.com/waitlist

# Writing (free): create a key at https://aistudio.google.com/apikey, no card needed
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# reel = animated video (default), card = still image
DAILY_FORMAT=reel

# Instagram Business or Creator account (README "Instagram access"). No Facebook Page needed.
IG_ACCESS_TOKEN=
# Optional: found automatically from the token when empty
IG_USER_ID=

# Public folder Instagram downloads media from. The GitHub workflow sets this itself.
MEDIA_BASE_URL=
